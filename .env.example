# ---- Discord ----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID from the same app's General Information page
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server (instant). Leave blank for
# global registration, which can take up to an hour to appear.
DISCORD_GUILD_ID=

# ---- Polling ----------------------------------------------------------------
POLL_INTERVAL_MINUTES=20
POLL_JITTER_SECONDS=30
POLL_CONCURRENCY=3
DELIVERED_RETENTION_HOURS=48
UNKNOWN_RETENTION_HOURS=336
MAX_PACKAGES_PER_USER=25

# ---- Carrier APIs -----------------------------------------------------------
# USPS: https://developer.usps.com (create an app, request the Tracking API)
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Test environment: https://apis-tem.usps.com
USPS_BASE_URL=https://apis.usps.com

# UPS: https://developer.ups.com (create an app, add the Tracking product)
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# Sandbox (CIE): https://wwwcie.ups.com
UPS_BASE_URL=https://onlinetools.ups.com

# FedEx: https://developer.fedex.com (create a project, enable Track API)
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# Sandbox: https://apis-sandbox.fedex.com
FEDEX_BASE_URL=https://apis.fedex.com

# ---- Runtime ----------------------------------------------------------------
DATA_DIR=./data
LOG_LEVEL=info
HEALTH_SERVER=true
PORT=8080
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2
